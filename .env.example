# OrcaRouter (https://api.orcarouter.ai/v1) — OpenAI-compatible endpoint
ORCAROUTER_API_KEY=your-orcarouter-key-here
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# Model tiers (OrcaRouter model IDs, format: <vendor>/<model-id>)
MODEL_CHEAP=openai/gpt-4o-mini
MODEL_STRONG=anthropic/claude-opus-5
MODEL_VISION=openai/gpt-4o-mini

# App
API_KEY=demo-local-api-key
DATABASE_URL=sqlite:///./kanjoai.db

# Set to "true" to run without calling OrcaRouter at all (uses a stubbed
# LLM response) — useful for local dev / demoing before a real key exists.
DRY_RUN=true
